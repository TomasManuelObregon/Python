# - - - - - - - - - - - - - - - - - - - - - - - - - -

'''
Esta funcion es un poco dificil de entender. Basicamente lo que hacer es reescalar la escala de voltaje del osciloscopio.
Define una funcion para subir la escala y una para bajarla. Luego con varios fors se evalua cual de todas maximiza la 
resolusion sin que sature.
'''

def escala(osci, CH, escala_actual):
    osci.write(f'MEASU:IMMed:SOURCE CH{CH}')
    osci.write(f'DATa:SOUrce CH{CH}')
    osci.write('MEASU:IMMed:TYPe PK2pk')
    
    osci.write(f'CH{CH}:POS 0')     # Cambiar offset del osci 
    
    osci_escalas = [.002, .005, .01, .02, .05, .1, .2, .5, 1, 2, 5]
    
    def escala_mas(escala_actual):
        escala_actual = escala_actual + 1
        if escala_actual > 10:
            escala_actual = 10
        osci.write(f'CH{CH}:SCA {osci_escalas[escala_actual]}')
        return escala_actual

    def escala_menos(escala_actual):
        escala_actual = escala_actual-1
        if (escala_actual < 0):
            escala_actual = 0
        osci.write(f'CH{CH}:SCA {osci_escalas[escala_actual]}')
        return escala_actual
    
    
    for i in range(10):
        time.sleep(.3)
        amplitud = float(osci.query('MEASU:IMMed:VALue?'))
        
        if amplitud > 200*float(osci.query('WFMPre:YMUlt?')):
            escala_actual = escala_mas(escala_actual)
        else:
            break
        
    for i in range(10):
        time.sleep(.3)
        amplitud = float(osci.query('MEASU:IMMed:VALue?'))
        
        if amplitud < 40*float(osci.query('WFMPre:YMUlt?')):
            escala_actual = escala_menos(escala_actual)
        else:
            break
        
    for i in range(10):
        time.sleep(.3)
        amplitud = float(osci.query('MEASU:IMMed:VALue?'))
        
        if amplitud > 200*float(osci.query('WFMPre:YMUlt?')):
            escala_actual = escala_mas(escala_actual)
        else:
            break

